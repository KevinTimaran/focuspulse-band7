{
  "configVersion": "v2",
  "app": {
    "appId": 1000005,
    "appName": "FocusPulse",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "FocusPulse",
    "description": "FocusPulse Smartwatch App for Xiaomi Smart Band 7"
  },
  "permissions": [
    "data:user.hd.heart_rate",
    "device:os.vibrate"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "1.0.0",
      "target": "1.0.1",
      "minVersion": "1.0.0"
    }
  },
  "targets": {
    "band-7": {
      "module": {
        "page": {
          "pages": [
            "page/index",
            "page/menu",
            "page/settings",
            "page/stats"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "name": "xiaomi-smart-band-7-international",
          "deviceSource": 263
        },
        {
          "name": "xiaomi-smart-band-7-china",
          "deviceSource": 260
        },
        {
          "name": "xiaomi-smart-band-7-nfc",
          "deviceSource": 262
        }
      ],
      "designWidth": 192
    }
  },
  "i18n": {
    "en-US": {
      "appName": "FocusPulse"
    }
  },
  "defaultLanguage": "en-US"
}
